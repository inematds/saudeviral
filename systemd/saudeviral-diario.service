[Unit]
Description=saudeviral — rodada diario (vídeo para o bot v3)
After=network-online.target explicavideos-display.service

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
Environment=DISPLAY=:99
ExecStart=/bin/bash %h/projetos/saudeviral/auto/rodar.sh diario
TimeoutStartSec=10h
MemoryMax=60G
Nice=5
